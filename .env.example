# =====================================
# MySQL Database 설정
# =====================================
DB_HOST=localhost           # DB 서버 호스트
DB_PORT=3306                # DB 포트
DB_NAME=backend_db          # DB 이름
DB_USERNAME=backend_user    # DB 사용자
DB_PASSWORD=secret_password # DB 비밀번호

# =====================================
# Redis 서버 설정
# =====================================
REDIS_HOST=localhost        # Redis 서버 호스트
REDIS_PORT=6379             # Redis 포트
REDIS_PASSWORD=             # Redis 비밀번호 (없으면 빈 값)

# =====================================
# JWT 설정
# =====================================
JWT_ACCESS_SECRET=yourAccessTokenSecretKeyHere   # 충분히 긴 랜덤 문자열
JWT_REFRESH_SECRET=yourRefreshTokenSecretKeyHere # 충분히 긴 랜덤 문자열

# =====================================
# Cookie 설정
# =====================================
COOKIE_DOMAIN=localhost     # 쿠키 도메인 (예: localhost, example.com)
COOKIE_SECURE=false         # HTTPS 사용 시 true
COOKIE_SAME_SITE=Lax        # Lax / Strict / None

# =====================================
# AWS S3 설정
# =====================================
BUCKET_NAME=your-test-bucket  # S3 버킷 이름
REGION=your-region            # S3 리전

# =====================================
# CORS 허용 Origin
# =====================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# =====================================
# 프론트엔드 base URL
# =====================================
# OAuth 로그인 완료 후 redirect, 비밀번호 재설정 메일의 링크 등에서 공통으로 사용된다.
# 경로(/password-reset/confirm 등)는 백엔드 코드에서 조합한다.
FRONT_BASE_URL=http://localhost:3000

# =====================================
# Mail (SMTP - Gmail) 설정
# =====================================
# Gmail은 2단계 인증 후 발급한 "앱 비밀번호"를 MAIL_PASSWORD에 사용해야 합니다.
MAIL_USERNAME=your-email@gmail.com  # 발신용 Gmail 주소
MAIL_PASSWORD=your-app-password     # Gmail 앱 비밀번호 (공백 제거)

# =====================================
# Groq API (AI 퀴즈 생성)
# =====================================
GROQ_API_KEY=your-groq-api-key  # https://console.groq.com 에서 발급

# =====================================
# GitHub OAuth 설정
# =====================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback   # 백엔드 콜백 URL
